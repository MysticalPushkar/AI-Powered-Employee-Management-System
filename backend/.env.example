# Copy this file to .env and fill in real values. Never commit .env.
# Server
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Cookie signing secret (use a long random value in production)
COOKIE_SECRET=change-me

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/ems

# JWT authentication
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Google Gemini API key for AI insights and performance reviews
GEMINI_API_KEY=

# Local background worker: start with `bun run inngest:dev`
INNGEST_DEV=1

# Production Inngest credentials
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Initial admin account created by `bun run seed` (idempotent)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@ems.local
ADMIN_PASSWORD=change-me-at-least-8-chars
